{
  "name": "@kepas/daraja-js",
  "version": "1.4.0",
  "description": "Type-safe Node.js/TypeScript SDK for Safaricom Daraja (M-Pesa). Encodes the production gotchas that silently break real PayBills.",
  "keywords": [
    "mpesa",
    "m-pesa",
    "daraja",
    "safaricom",
    "stk-push",
    "b2c",
    "c2b",
    "payments",
    "kenya"
  ],
  "license": "Apache-2.0",
  "author": "KEPAS Technologies Ltd",
  "homepage": "https://github.com/kepas-tech/daraja-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kepas-tech/daraja-js.git"
  },
  "bugs": {
    "url": "https://github.com/kepas-tech/daraja-js/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "PREREQUISITES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --dir tests/integration",
    "verify:published": "bash scripts/smoke-published.sh",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docs": "typedoc",
    "docs:errors": "node tools/gen-error-codes-docs.mjs",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/cli": "^2.27.9",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^25.9.1",
    "fast-check": "^4.8.0",
    "msw": "^2.4.11",
    "tsup": "^8.3.0",
    "typedoc": "^0.28.19",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
